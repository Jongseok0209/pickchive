{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pickchive-crawler",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  // GitHub Actions의 schedule은 5분 요청에도 실제로는 ~1시간 간격으로만
  // 실행돼서(실측) Cloudflare Cron을 주 스케줄러로 사용한다. 상세는 src/index.ts 주석 참고.
  // scheduled()는 CPU 시간 제한 때문에 한 번에 사이트 1개만 처리한다(2026-08-16
  // 확인, 3개만 묶어도 매번 죽음). BATCH_SIZE를 올리는 대신 매 분(0~4분 오프셋)
  // 크론을 5개 등록해서 인보케이션당 CPU 사용량은 그대로 두고 처리량만 늘린다 —
  // 5분에 5번(=1분마다) 도니까 12개 전체 로테이션이 60분에서 약 12분으로 준다.
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "1-59/5 * * * *",
      "2-59/5 * * * *",
      "3-59/5 * * * *",
      "4-59/5 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pickchive-db",
      "database_id": "72c72958-3bcc-4c93-85c8-8f6e82c87022"
    }
  ]
}

---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getSiteCrawlHealth, type SiteCrawlHealth } from "@/lib/crawlHealth";
import { getRecentCronBatches, type CronBatch } from "@/lib/cronHealth";
import { formatElapsedLabel } from "@/lib/format";

export const prerender = false;

type Status = "no-attempt" | "failing" | "stale" | "ok";

// 크론이 5분마다 도니까, 15분 넘게 새 시도가 없으면 (성공했던 마지막 시도라도)
// 스케줄러 자체가 멈췄다는 신호로 본다.
const STALE_MINUTES = 15;

function minutesSince(dateStr: string): number {
  const date = new Date(dateStr.endsWith("Z") ? dateStr : dateStr + "Z");
  return (Date.now() - date.getTime()) / 60000;
}

function classify(site: SiteCrawlHealth): Status {
  if (!site.lastAttemptAt) return "no-attempt";
  if (site.lastAttemptOk === 0) return "failing";
  if (minutesSince(site.lastAttemptAt) > STALE_MINUTES) return "stale";
  return "ok";
}

const STATUS_ORDER: Record<Status, number> = {
  "no-attempt": 0,
  failing: 1,
  stale: 2,
  ok: 3,
};

const STATUS_LABEL: Record<Status, string> = {
  "no-attempt": "시도 안 함",
  failing: "실패 중",
  stale: "지연",
  ok: "정상",
};

const STATUS_CLASSES: Record<Status, string> = {
  "no-attempt": "bg-muted text-foreground/60",
  failing: "bg-red-500/10 text-red-600",
  stale: "bg-yellow-500/10 text-yellow-600",
  ok: "bg-green-500/10 text-green-600",
};

const rawSites = await getSiteCrawlHealth();

const sites = rawSites
  .map(site => ({ site, status: classify(site) }))
  .sort((a, b) => {
    const order = STATUS_ORDER[a.status] - STATUS_ORDER[b.status];
    if (order !== 0) return order;
    const aMins = a.site.lastAttemptAt ? minutesSince(a.site.lastAttemptAt) : 0;
    const bMins = b.site.lastAttemptAt ? minutesSince(b.site.lastAttemptAt) : 0;
    return bMins - aMins;
  });

// 크론 배치(scheduled() 실행) 진단 — 크론이 아예 안 도는지, 도는데 중간에
// 죽는지를 사이트별 상태만 보고는 알 수 없어서 별도로 보여준다.
// 자세한 배경은 cron_batches 마이그레이션/getRecentCronBatches 주석 참고.
const CRON_STUCK_MINUTES = 10; // 배치 하나가 3개씩 처리하니 5분 주기보다 여유를 둔다
const cronBatches = await getRecentCronBatches(10);
const latestBatch: CronBatch | undefined = cronBatches[0];
const cronNotFiring =
  !latestBatch || minutesSince(latestBatch.startedAt) > CRON_STUCK_MINUTES;
const cronDied = !!latestBatch && !latestBatch.finishedAt && !cronNotFiring;
---

<Layout title="크롤 상태 | 픽카이브">
  <Header />
  <main id="main-content" class="app-layout my-1 max-w-2xl">
    <h1 class="mt-6 text-xl font-bold">크롤 상태</h1>
    <p class="text-foreground/60 mt-1 text-sm">
      커뮤니티별 마지막 수집 시도 결과예요. 5분마다 자동으로 다시 수집을
      시도합니다.
    </p>

    <section class="border-border bg-muted/40 mt-4 rounded border p-3">
      <h2 class="text-sm font-semibold">크론 배치 진단</h2>
      {
        cronNotFiring && (
          <p class="mt-1 text-xs text-red-600">
            {latestBatch
              ? `마지막 배치 시작이 ${Math.round(minutesSince(latestBatch.startedAt))}분 전이에요 — 스케줄러 자체가 멈췄을 수 있어요.`
              : "배치 기록이 아직 없어요."}
          </p>
        )
      }
      {
        cronDied && (
          <p class="mt-1 text-xs text-red-600">
            마지막 배치가 끝나지 않았어요 — 도중에 강제 종료됐을 수 있어요(예:
            CPU 시간 제한).
          </p>
        )
      }
      {
        !cronNotFiring && !cronDied && latestBatch && (
          <p class="mt-1 text-xs text-green-600">
            정상적으로 돌고 있어요 — 마지막 배치{" "}
            {formatElapsedLabel(latestBatch.startedAt, "시작")}, [
            {latestBatch.sites}] 중 {latestBatch.sitesOk}개 성공.
          </p>
        )
      }
      {
        cronBatches.length > 0 && (
          <ul class="mt-2 space-y-1 text-xs">
            {cronBatches.map(b => (
              <li class="text-foreground/60 flex flex-wrap gap-x-2">
                <span>{formatElapsedLabel(b.startedAt, "시작")}</span>
                <span>[{b.sites}]</span>
                <span>
                  {b.finishedAt ? `${b.sitesOk}개 성공` : "미완료"}
                </span>
                {b.error && <span class="text-red-600/80">{b.error}</span>}
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <ul class="mt-4">
      {
        sites.map(({ site, status }) => {
          const lastAttemptLabel = site.lastAttemptAt
            ? formatElapsedLabel(site.lastAttemptAt, "마지막 시도")
            : null;
          const lastSuccessLabel = site.lastSuccessAt
            ? formatElapsedLabel(site.lastSuccessAt, "마지막 성공")
            : null;
          return (
            <li class="border-border border-b py-3">
              <div class="flex items-center justify-between gap-2">
                <span class="font-medium">{site.name}</span>
                <span
                  class:list={[
                    "shrink-0 rounded px-2 py-0.5 text-xs font-medium",
                    STATUS_CLASSES[status],
                  ]}
                >
                  {STATUS_LABEL[status]}
                </span>
              </div>
              <div class="text-foreground/60 mt-1 flex flex-wrap gap-x-3 text-xs">
                <span>보관 중인 글 {site.postCount}개</span>
                {lastAttemptLabel && <span>{lastAttemptLabel}</span>}
                {lastSuccessLabel && status !== "ok" && (
                  <span>{lastSuccessLabel}</span>
                )}
                {site.attempts24h > 0 && (
                  <span>
                    24시간 내 {site.attempts24h}회 시도 · 실패 {site.fails24h}회
                  </span>
                )}
              </div>
              {status !== "ok" && site.lastError && (
                <p class="mt-1 text-xs break-words text-red-600/80">
                  {site.lastError}
                </p>
              )}
            </li>
          );
        })
      }
    </ul>
  </main>
  <Footer />
</Layout>

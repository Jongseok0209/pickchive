---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PostRow from "@/components/PostRow.astro";
import {
  getRankedPosts,
  getSites,
  TIME_WINDOWS,
  DEFAULT_WINDOW,
  type SortKey,
} from "@/lib/posts";
import { getUserFilterPrefs, saveUserFilterPrefs } from "@/lib/userPrefs";

export const prerender = false;

const PAGE_SIZE = 20;

const hasFilterParams =
  Astro.url.searchParams.has("window") ||
  Astro.url.searchParams.has("sort") ||
  Astro.url.searchParams.has("site");
// "전체/3시간/종합"처럼 전부 기본값으로 되돌리는 클릭은 window/sort/site를 전부
// 생략한 "/" 그대로라 hasFilterParams만으로는 "필터 없이 맨 처음 들어온 것"과
// 구분이 안 된다 — 로그인 상태에서 저장된 필터가 있으면 "전체"를 눌러도 그
// 저장된 값으로 계속 되돌아가 버리는 버그가 있었다(2026-08-16 확인: 필터를
// 기본값으로 되돌리는 시도가 계속 씹히는 것처럼 보임). buildUrl/buildClientUrl이
// 전부 기본값인 링크를 만들 때 reset=1을 붙여 "명시적으로 고른 기본값"임을
// 표시하고, 클라이언트에서 로드 직후 주소창에서만 지운다.
const isExplicitReset = Astro.url.searchParams.get("reset") === "1";
const hasExplicitFilterIntent = hasFilterParams || isExplicitReset;
const userId = await Astro.session?.get("userId");

// 로그인한 회원이 필터 없이 맨 홈으로 들어오면, 하드코딩된 기본값 대신 마지막으로
// 쓴 필터를 기본으로 깔아준다. 반대로 필터가 붙었거나(공유 링크 등 포함) 명시적
// 리셋이면 하드코딩 값이 아니라 그 필터를 저장해서 다음 방문에 이어지게 한다.
const savedPrefs =
  !hasExplicitFilterIntent && userId ? await getUserFilterPrefs(userId) : null;

const windowParam =
  Astro.url.searchParams.get("window") ?? savedPrefs?.window ?? DEFAULT_WINDOW;
const sortParam = (Astro.url.searchParams.get("sort") ??
  savedPrefs?.sort ??
  "score") as SortKey;
// 사이트 필터는 다중 선택 지원 — 콤마로 이어붙인 slug 목록, 비어있으면 전체.
const siteParam =
  Astro.url.searchParams.get("site") ?? savedPrefs?.site ?? "";
const selectedSites = siteParam.split(",").filter(Boolean);

if (hasExplicitFilterIntent && userId) {
  await saveUserFilterPrefs(userId, {
    window: windowParam,
    sort: sortParam,
    site: siteParam,
  });
}

const [posts, sites] = await Promise.all([
  getRankedPosts({
    window: windowParam,
    sort: sortParam,
    site: selectedSites.length ? selectedSites : undefined,
    limit: PAGE_SIZE,
    offset: 0,
  }),
  getSites(),
]);

const nextOffset = posts.length === PAGE_SIZE ? PAGE_SIZE : null;

function buildUrl(overrides: Record<string, string | null>): string {
  const params = new URLSearchParams();
  const merged = {
    window: windowParam,
    sort: sortParam,
    site: siteParam,
    ...overrides,
  };
  if (merged.window && merged.window !== DEFAULT_WINDOW)
    params.set("window", merged.window);
  if (merged.sort && merged.sort !== "score") params.set("sort", merged.sort);
  if (merged.site) params.set("site", merged.site);
  // 세 필터가 전부 기본값으로 되돌아가는 링크(예: "전체" 버튼)는 파라미터가 다
  // 빠져서 "필터 없이 맨 처음 들어온 것"과 구분이 안 된다 — 로그인 사용자의
  // 저장된 필터를 되살리는 로직이 이걸 가로채 버리지 않도록 명시 표시를 남긴다.
  if (params.toString() === "") params.set("reset", "1");
  const qs = params.toString();
  return qs ? `/?${qs}` : "/";
}

const SORT_OPTIONS: { key: SortKey; label: string }[] = [
  { key: "score", label: "종합" },
  { key: "views", label: "조회수" },
  { key: "recommend", label: "추천수" },
  { key: "comments", label: "댓글수" },
];
---

<Layout noindex={hasFilterParams || isExplicitReset}>
  <Header />
  <main
    id="main-content"
    class="app-layout my-1"
    data-window={windowParam}
    data-sort={sortParam}
    data-site={siteParam}
    data-reset={isExplicitReset ? "1" : ""}
    data-next-offset={nextOffset ?? ""}
  >
    <section class="border-border border-b pt-6 pb-4">
      <div>
        <nav class="mb-2 flex flex-wrap gap-1" aria-label="기간 필터">
          {
            TIME_WINDOWS.map(w => (
              <a
                href={buildUrl({ window: w.key })}
                rel="nofollow"
                data-window-value={w.key}
                class:list={[
                  "rounded px-3 py-1.5 text-sm font-medium",
                  w.key === windowParam
                    ? "bg-accent text-accent-foreground"
                    : "bg-muted hover:text-accent",
                ]}
              >
                {w.label}
              </a>
            ))
          }
        </nav>

        <nav class="mb-2 flex flex-wrap gap-1" aria-label="정렬 기준">
          {
            SORT_OPTIONS.map(s => (
              <a
                href={buildUrl({ sort: s.key })}
                rel="nofollow"
                data-sort-value={s.key}
                class:list={[
                  "rounded px-2.5 py-1 text-xs font-medium",
                  s.key === sortParam
                    ? "border-accent text-accent border"
                    : "border-border text-foreground/60 hover:text-accent border",
                ]}
              >
                {s.label}
              </a>
            ))
          }
        </nav>

        <nav class="flex flex-wrap gap-1" aria-label="사이트 필터">
          <a
            href={buildUrl({ site: null })}
            rel="nofollow"
            data-site-value=""
            class:list={[
              "rounded px-2.5 py-1 text-xs font-medium",
              !siteParam
                ? "border-accent text-accent border"
                : "border-border text-foreground/60 hover:text-accent border",
            ]}
          >
            전체
          </a>
          {
            sites.map(s => {
              const isActive = selectedSites.includes(s.slug);
              const toggled = isActive
                ? selectedSites.filter(x => x !== s.slug)
                : [...selectedSites, s.slug];
              return (
                <a
                  href={buildUrl({
                    site: toggled.length ? toggled.join(",") : null,
                  })}
                  rel="nofollow"
                  data-site-value={s.slug}
                  class:list={[
                    "rounded px-2.5 py-1 text-xs font-medium",
                    isActive
                      ? "border-accent text-accent border"
                      : "border-border text-foreground/60 hover:text-accent border",
                  ]}
                >
                  {s.name}
                </a>
              );
            })
          }
        </nav>

        {
          !userId && (
            <p class="text-foreground/50 mt-2 text-xs">
              <a href="/login" class="text-accent hover:underline">
                로그인
              </a>
              하면 마지막에 쓴 필터를 다음에도 그대로 기억해요.
            </p>
          )
        }
      </div>

      <div class="mt-3">
        <input
          type="search"
          id="search-input"
          placeholder="글 제목으로 검색"
          aria-label="글 제목으로 검색"
          class="border-border bg-background focus:border-accent w-full rounded border px-3 py-2 text-sm outline-none"
        />
      </div>
    </section>

    <ul id="post-list" class="pt-2">
      {posts.map(post => <PostRow post={post} />)}
      {
        posts.length === 0 && (
          <li class="text-foreground/60 py-12 text-center">
            아직 수집된 글이 없어요. 잠시 후 다시 확인해주세요.
          </li>
        )
      }
    </ul>

    <div id="infinite-sentinel" class="h-10"></div>
    <p
      id="loading-indicator"
      class="text-foreground/50 hidden py-4 text-center text-sm"
    >
      불러오는 중...
    </p>
  </main>
  <Footer />
</Layout>

<script>
  function formatCount(n: number): string {
    if (n >= 10000) {
      const man = n / 10000;
      return `${man >= 100 ? Math.round(man) : man.toFixed(1).replace(/\.0$/, "")}만`;
    }
    if (n >= 1000) {
      const cheon = n / 1000;
      return `${cheon.toFixed(1).replace(/\.0$/, "")}천`;
    }
    return String(n);
  }

  function formatElapsedLabel(dateStr: string | null, label: string): string {
    if (!dateStr) return "";
    const date = new Date(dateStr.endsWith("Z") ? dateStr : dateStr + "Z");
    const now = new Date();
    const diffSec = Math.floor((now.getTime() - date.getTime()) / 1000);

    if (diffSec < 60) return `방금 ${label}`;
    const diffMin = Math.floor(diffSec / 60);
    if (diffMin < 60) return `${label} ${diffMin}분 전`;
    const diffHour = Math.floor(diffMin / 60);
    if (diffHour < 24) return `${label} ${diffHour}시간 전`;
    const diffDay = Math.floor(diffHour / 24);
    return `${label} ${diffDay}일 전`;
  }

  function decodeEntities(s: string): string {
    let decoded = s;
    let prev = "";
    while (decoded !== prev) {
      prev = decoded;
      decoded = decoded
        .replace(/&quot;/gi, '"')
        .replace(/&apos;/gi, "'")
        .replace(/&amp;/gi, "&")
        .replace(/&lt;/gi, "<")
        .replace(/&gt;/gi, ">")
        .replace(/&#039;/g, "'")
        .replace(/&#39;/g, "'")
        .replace(/&#(\d+);/g, (_, code) => String.fromCharCode(Number(code)))
        .replace(/&#x([0-9a-f]+);/gi, (_, code) =>
          String.fromCharCode(parseInt(code, 16))
        );
    }
    return decoded;
  }

  function escapeHtml(s: string): string {
    return decodeEntities(s)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  // 일부 사이트는 제목 끝에 이미 "(N)" 형태로 댓글수를 붙여 보여준다(예: "... (10)").
  // 이 경우 배지도 같은 "(N)" 형태라 또 붙이면 숫자가 그대로 중복 노출된다.
  function titleHasCommentCountSuffix(
    title: string,
    commentCount: number | null
  ): boolean {
    if (!commentCount) return false;
    const match = title.match(/\((\d+)\)\s*$/);
    return !!match && Number(match[1]) === commentCount;
  }

  // 클릭해서 읽은 글은 제목을 흐리게 표시한다. 로그인/DB 없이 이 브라우저에서만
  // 기억하면 되는 정보라 localStorage로 충분하다. 오래된 항목은 잘라내서
  // 무한정 커지지 않게 한다.
  const READ_POSTS_KEY = "pc-read-posts";
  const MAX_READ_POSTS = 500;
  const READ_LINK_CLASS = "text-foreground/40";

  function getReadIds(): string[] {
    try {
      const raw = localStorage.getItem(READ_POSTS_KEY);
      const parsed = raw ? JSON.parse(raw) : [];
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  }

  function markPostRead(id: string): void {
    try {
      const ids = getReadIds().filter(existing => existing !== id);
      ids.push(id);
      if (ids.length > MAX_READ_POSTS) {
        ids.splice(0, ids.length - MAX_READ_POSTS);
      }
      localStorage.setItem(READ_POSTS_KEY, JSON.stringify(ids));
    } catch {
      // localStorage 접근 불가(프라이빗 모드 등)해도 기능 자체는 계속 동작
    }
  }

  function applyReadStyles(root: HTMLElement): void {
    const readIds = new Set(getReadIds());
    if (readIds.size === 0) return;
    root.querySelectorAll<HTMLElement>("li[data-post-id]").forEach(li => {
      const id = li.dataset.postId;
      if (!id || !readIds.has(id)) return;
      li.querySelector<HTMLAnchorElement>(
        "[data-post-title-link]"
      )?.classList.add(READ_LINK_CLASS);
    });
  }

  interface Post {
    id: number;
    title: string;
    url: string;
    author: string | null;
    viewCount: number;
    recommendCount: number;
    commentCount: number | null;
    category: string | null;
    postedAtRaw: string | null;
    firstSeenAt: string;
    crawledAt: string;
    siteSlug: string;
    siteName: string;
  }

  function renderRow(post: Post): string {
    const metaParts: string[] = [];
    if (post.author) metaParts.push(`<span>${escapeHtml(post.author)}</span>`);
    if (post.postedAtRaw)
      metaParts.push(`<span>${escapeHtml(post.postedAtRaw)}</span>`);
    metaParts.push(`<span>조회 ${formatCount(post.viewCount)}</span>`);
    metaParts.push(`<span>추천 ${formatCount(post.recommendCount)}</span>`);
    const postedAgeLabel = formatElapsedLabel(post.firstSeenAt, "게시");
    if (postedAgeLabel) metaParts.push(`<span>${postedAgeLabel}</span>`);
    const updatedAgeLabel = formatElapsedLabel(post.crawledAt, "업데이트");
    if (updatedAgeLabel)
      metaParts.push(
        `<span class="text-accent/80 font-medium">${updatedAgeLabel}</span>`
      );
    if (post.category)
      metaParts.push(`<span>${escapeHtml(post.category)}</span>`);
    metaParts.push(
      `<a href="/p/${post.id}#comments" data-astro-reload class="text-accent hover:underline">댓글 보기</a>`
    );

    const commentBadge =
      post.commentCount &&
      !titleHasCommentCountSuffix(decodeEntities(post.title), post.commentCount)
        ? `<span class="text-foreground/50 ms-1 text-sm" title="크롤링 시점 기준 원본 댓글 수 (실시간 아님)">(${post.commentCount})</span>`
        : "";

    return `<li class="border-border border-b py-3" data-post-id="${post.id}">
      <div class="flex items-start gap-2">
        <span class="bg-muted text-foreground/70 shrink-0 rounded px-1.5 py-0.5 text-xs font-medium" data-site="${post.siteSlug}">${escapeHtml(post.siteName)}</span>
        <div class="min-w-0 flex-1">
          <a href="${escapeHtml(post.url)}" rel="noopener noreferrer nofollow" data-post-title-link class="hover:text-accent font-medium break-words">${escapeHtml(post.title)}</a>
          ${commentBadge}
          <div class="text-foreground/60 mt-1 flex flex-wrap gap-x-2 text-xs">${metaParts.join("")}</div>
        </div>
      </div>
    </li>`;
  }

  // 홈 피드는 무한스크롤이라, 처음 20개 이후로 스크롤해서 불러온 글들은
  // 서버가 렌더링한 HTML에는 없고 이 탭의 메모리(DOM)에만 존재한다.
  // 글 제목을 눌러 다른 사이트로 이동했다가 브라우저가 이 탭을
  // 메모리 부족 등으로 새로고침(tab discard)해버리면, 스크롤 위치를
  // 완벽히 복원해도 페이지 자체가 처음 20개짜리로 훨씬 짧아져 있어서
  // 사실상 맨 위로 돌아간 것처럼 느껴진다. 그래서 스크롤 위치뿐 아니라
  // "몇 개나 불러왔었는지"도 같이 저장해뒀다가, 새로고침되면 그만큼
  // 먼저 다시 불러온 다음에 스크롤을 복원한다.
  const FEED_STATE_KEY = "pc-feed-state";

  // 브라우저 자체 스크롤 복원은 우리가 글을 다시 불러오기 "전"(=페이지가 20개짜리로
  // 짧을 때) 실행돼서 엉뚱한 위치로 튄 뒤, 그 스크롤 이벤트가 저장 로직을 건드려
  // 원래 위치를 덮어써버린다. 복원은 우리가 직접 하므로 브라우저 것은 끈다.
  if ("scrollRestoration" in history) history.scrollRestoration = "manual";

  // 외부 사이트로 나갔다가 뒤로가기하면 브라우저가 페이지를 완전히 새로 불러오지
  // 않고 bfcache(떠날 때 DOM을 그대로 얼려뒀다가 그대로 되살리는 캐시)에서
  // 복원하는 경우가 있다(실기기, 특히 모바일 Safari에서 흔함). 이때는
  // astro:page-load가 다시 발생하지 않아 아래 restoreFeedState가 아예 안
  // 불리는데, 방금 껐던 브라우저 자체 스크롤 복원도 안 되니 스크롤이 맨 위로
  // 보인다 — DOM(글 개수)은 bfcache가 그대로 들고 있으니 스크롤 위치만
  // 직접 다시 잡아주면 된다. bfcache 복원 시에는 반드시 pageshow가
  // event.persisted=true로 발생한다(모든 주요 브라우저에서 보장됨).
  window.addEventListener("pageshow", e => {
    if (!e.persisted) return; // 일반 로드는 astro:page-load 쪽이 처리
    let saved: { path: string; scrollY: number } | null = null;
    try {
      const raw = sessionStorage.getItem(FEED_STATE_KEY);
      saved = raw ? JSON.parse(raw) : null;
    } catch {
      saved = null;
    }
    if (!saved || saved.path !== location.pathname + location.search) return;
    window.scrollTo(0, saved.scrollY);
  });

  // 복원이 진행되는 동안에는 저장하지 않는다. 복원 중 발생하는 스크롤/로드가
  // 저장된 목표값(원래 보던 위치)을 덮어쓰면 복원 자체가 무의미해진다.
  let restoringFeed = false;
  let feedListeners: AbortController | undefined;

  // 검색 중이었는지/검색어가 뭐였는지도 같이 저장해야, 검색 결과 글을 눌렀다가
  // 뒤로가기했을 때 기본 목록이 아니라 그 검색 결과로 복원할 수 있다.
  let searchModeActive = false;
  let searchQuery = "";

  function saveFeedState(list: HTMLUListElement) {
    if (restoringFeed) return;
    try {
      sessionStorage.setItem(
        FEED_STATE_KEY,
        JSON.stringify({
          path: location.pathname + location.search,
          itemCount: list.children.length,
          scrollY: window.scrollY,
          query: searchModeActive ? searchQuery : "",
        })
      );
    } catch {
      // sessionStorage 접근 불가(프라이빗 모드 등)해도 기능 자체는 계속 동작
    }
  }

  function setupInfiniteScroll() {
    const main = document.querySelector<HTMLElement>("#main-content");
    const list = document.querySelector<HTMLUListElement>("#post-list");
    const sentinel = document.querySelector<HTMLElement>("#infinite-sentinel");
    const loadingEl = document.querySelector<HTMLElement>("#loading-indicator");
    if (!main || !list || !sentinel || !loadingEl) return;

    // reset=1은 서버에게만 필요한 표시(로그인 사용자의 저장된 필터를 되살리지
    // 말라는 신호)라 화면 주소창/공유 링크에는 남길 필요가 없다 — 로드 직후
    // 한 번만 조용히 지운다.
    if (main.dataset.reset === "1") {
      const url = new URL(location.href);
      url.searchParams.delete("reset");
      history.replaceState(history.state, "", url.pathname + url.search);
    }

    applyReadStyles(list);

    let nextOffset: number | null = main.dataset.nextOffset
      ? Number(main.dataset.nextOffset)
      : null;
    let loading = false;

    // 검색 관련 상태/함수를 restoreFeedState보다 먼저 선언해야, 뒤로가기 복원 시
    // 저장된 검색어로 runSearch를 곧바로 이어 부를 수 있다.
    const searchInput =
      document.querySelector<HTMLInputElement>("#search-input");
    let feedSnapshotHTML = "";
    let feedNextOffset: number | null = null;

    // 검색 중이어도 현재 화면에 걸려있는 기간/정렬/사이트 필터는 그대로 유지한 채
    // 그 안에서만 제목 검색을 한다(별도 검색 모드가 아니라 같은 필터의 연장선).
    function currentFilterParams(offset: number): URLSearchParams {
      const params = new URLSearchParams({
        window: main!.dataset.window ?? "3h",
        sort: main!.dataset.sort ?? "score",
        offset: String(offset),
      });
      if (main!.dataset.site) params.set("site", main!.dataset.site);
      if (searchModeActive) params.set("q", searchQuery);
      return params;
    }

    // 이미 목록에 있는 글은 다시 그리지 않는다.
    //
    // OFFSET 페이지네이션인데 정렬 기준이 페이지를 받는 사이에 바뀐다 — 점수
    // (조회수 + 추천수×10)는 크롤러가 5분마다 갱신하고, 시간 창(`now - N시간`)도
    // 요청마다 새로 계산된다. 그래서 페이지1 끝자락에 있던 글이 밀려 내려가면
    // 페이지2 첫머리에 다시 실려 온다. DB에는 행이 하나뿐이고(새로고침하면 하나로
    // 보인다) 순수하게 그리는 쪽 문제다.
    //
    // 주의: 이건 눈에 보이는 중복만 막는다. 반대 방향(순위가 올라가서 두 페이지
    // 어디에도 안 실리는 글)은 그대로 누락된다. 근본 해결은 커서 페이지네이션이다.
    function appendPosts(posts: Post[]): void {
      const seen = new Set(
        Array.from(list!.querySelectorAll<HTMLElement>("li[data-post-id]")).map(
          li => li.dataset.postId
        )
      );
      const fresh = posts.filter(p => !seen.has(String(p.id)));
      if (!fresh.length) return;
      list!.insertAdjacentHTML(
        "beforeend",
        fresh.map(p => renderRow(p)).join("")
      );
    }

    async function loadMore(): Promise<boolean> {
      if (loading || nextOffset === null) return false;
      loading = true;
      loadingEl!.classList.remove("hidden");

      try {
        const res = await fetch(
          `/api/posts?${currentFilterParams(nextOffset)}`
        );
        const data = (await res.json()) as {
          posts: Post[];
          nextOffset: number | null;
        };
        appendPosts(data.posts);
        applyReadStyles(list!);
        nextOffset = data.nextOffset;
        if (nextOffset === null) observer.disconnect();
        return data.posts.length > 0;
      } catch {
        // 네트워크 오류 시 다음 스크롤에서 재시도
        return false;
      } finally {
        loading = false;
        loadingEl!.classList.add("hidden");
      }
    }

    const observer = new IntersectionObserver(entries => {
      if (!entries[0].isIntersecting) return;
      void loadMore();
    });

    // 새로 로드된 페이지는 아이템이 20개뿐이라 sentinel이 화면 안에 바로 들어와
    // observer가 즉시 발동한다. 복원 로직(아래)이 목표 개수만큼 순차적으로
    // 불러오는 도중에 observer가 동시에 추가로 더 불러와버리면 개수가 목표를
    // 넘어서고(예: 140개 복원 중인데 160개가 됨), scrollTo도 그 사이에 씹혀서
    // 0으로 되돌아가는 문제가 있었다(실제 재현 후 확인). 그래서 복원이 끝날
    // 때까지 observer를 붙이지 않는다.
    async function restoreFeedState(): Promise<void> {
      let saved: {
        path: string;
        itemCount: number;
        scrollY: number;
        query?: string;
      } | null = null;
      try {
        const raw = sessionStorage.getItem(FEED_STATE_KEY);
        saved = raw ? JSON.parse(raw) : null;
      } catch {
        saved = null;
      }
      if (!saved || saved.path !== location.pathname + location.search) return;

      restoringFeed = true;

      if (saved.query) {
        // 검색 결과 글을 눌렀다가 돌아온 경우: 기본 목록이 아니라 그 검색을
        // 먼저 다시 실행한 뒤, 그 결과 기준으로 이어서 더 불러온다.
        if (searchInput) searchInput.value = saved.query;
        await runSearch(saved.query);
      }

      while (list!.children.length < saved.itemCount) {
        const gotMore = await loadMore();
        if (!gotMore) break;
      }
      // 마지막에 붙은 항목들의 이미지/레이아웃이 자리를 잡은 뒤에 스크롤해야
      // 목표 위치에 정확히 안착한다.
      await new Promise(resolve => requestAnimationFrame(() => resolve(null)));
      window.scrollTo(0, saved.scrollY);
    }

    restoreFeedState().finally(() => {
      restoringFeed = false;
      observer.observe(sentinel);
    });

    // window/document 리스너는 DOM 교체(Astro 뷰 트랜지션)로 사라지지 않는다.
    // 페이지를 오갈 때마다 setup이 다시 불리므로 정리하지 않으면 리스너가
    // 겹겹이 쌓이고, 오래된 리스너가 이미 화면에서 떨어져 나간 옛 목록을
    // 참조한 채 엉뚱한 값을 저장해 복원을 망가뜨린다.
    feedListeners?.abort();
    feedListeners = new AbortController();
    const { signal } = feedListeners;

    let scrollSaveTimer: number | undefined;
    window.addEventListener(
      "scroll",
      () => {
        window.clearTimeout(scrollSaveTimer);
        scrollSaveTimer = window.setTimeout(() => saveFeedState(list!), 200);
      },
      { passive: true, signal }
    );
    document.addEventListener(
      "visibilitychange",
      () => {
        if (document.visibilityState === "hidden") saveFeedState(list!);
      },
      { signal }
    );
    window.addEventListener("pagehide", () => saveFeedState(list!), { signal });

    // pagehide/visibilitychange 시점엔 브라우저가 이미 스크롤 위치를 0으로
    // 되돌려놓은 뒤라(실제 확인함 — 저장된 scrollY가 항상 0으로 찍힘) 너무 늦다.
    // 글 링크를 실제로 누르는 그 순간(클릭 캡처 단계, 아직 페이지 이동 전)에
    // 곧바로 저장해야 정확한 스크롤 위치가 남는다.
    list!.addEventListener(
      "click",
      e => {
        const link = (e.target as HTMLElement).closest("a");
        if (!link) return;
        saveFeedState(list!);

        if (link.matches("[data-post-title-link]")) {
          const id =
            link.closest<HTMLElement>("li[data-post-id]")?.dataset.postId;
          if (id) {
            markPostRead(id);
            link.classList.add(READ_LINK_CLASS);
          }
        }
      },
      { capture: true, signal }
    );

    // 검색: 페이지 이동 없이 같은 화면에서, 지금 걸려있는 기간/정렬/사이트
    // 필터 안에서만 목록을 검색 결과로 바꿔치기한다.
    function emptySearchResultHTML(query: string): string {
      return `<li class="text-foreground/60 py-12 text-center">"${escapeHtml(query)}" 검색 결과가 없어요.</li>`;
    }

    async function runSearch(query: string): Promise<void> {
      if (!searchModeActive) {
        // 검색 시작 시점의 목록(스크롤로 더 불러온 것까지 포함)을 스냅샷해뒀다가
        // 검색어를 지우면 원래 보던 그대로 되돌려준다.
        feedSnapshotHTML = list!.innerHTML;
        feedNextOffset = nextOffset;
      }
      searchModeActive = true;
      searchQuery = query;
      observer.disconnect();
      loading = true;
      loadingEl!.classList.remove("hidden");

      try {
        const res = await fetch(`/api/posts?${currentFilterParams(0)}`);
        const data = (await res.json()) as {
          posts: Post[];
          nextOffset: number | null;
        };
        list!.innerHTML = data.posts.length
          ? data.posts.map(p => renderRow(p)).join("")
          : emptySearchResultHTML(query);
        applyReadStyles(list!);
        nextOffset = data.nextOffset;
      } catch {
        // 네트워크 오류 시 다음 입력에서 재시도
      } finally {
        loading = false;
        loadingEl!.classList.add("hidden");
        // 뒤로가기 복원 중에는 restoreFeedState가 끝난 뒤 한 번에 observer를
        // 붙인다 — 여기서 미리 붙이면 목표 개수까지 불러오는 도중에 observer가
        // 동시에 더 불러와버려 개수가 목표를 넘어서는 문제가 재현된다.
        if (nextOffset !== null && !restoringFeed) observer.observe(sentinel!);
      }
    }

    function exitSearch(): void {
      searchModeActive = false;
      searchQuery = "";
      list!.innerHTML = feedSnapshotHTML;
      applyReadStyles(list!);
      nextOffset = feedNextOffset;
      observer.disconnect();
      if (nextOffset !== null) observer.observe(sentinel!);
    }

    let searchDebounceTimer: number | undefined;
    searchInput?.addEventListener(
      "input",
      () => {
        window.clearTimeout(searchDebounceTimer);
        const value = searchInput.value.trim();
        searchDebounceTimer = window.setTimeout(() => {
          if (value) void runSearch(value);
          else if (searchModeActive) exitSearch();
        }, 300);
      },
      { signal }
    );

    // 각 필터 버튼의 href는 서버 렌더링 시점(buildUrl)에 한 번만 계산돼서, 그
    // 시점의 window/sort/site 조합이 그대로 굳어있다. 검색 중에 필터 하나를
    // JS로 바꾸면(페이지 재로드 없이) 그 필터 자신의 href만 최신이 아니라
    // *다른* 필터 버튼들의 href도 예전 조합인 채로 남는다 — 그 상태에서 검색을
    // 끝내고 다른 버튼을 누르면 방금 바꾼 적 없는 필터까지 예전 값으로 같이
    // 튀어버린다(실제 재현: "전체" 눌렀는데 기간이 24시간으로 바뀜). 그래서
    // 필터를 하나 바꿀 때마다 현재 상태 기준으로 모든 버튼의 href를 다시 계산해준다.
    function buildClientUrl(
      overrides: Partial<Record<"window" | "sort" | "site", string>>
    ): string {
      const params = new URLSearchParams();
      const state = {
        window: main!.dataset.window || "3h",
        sort: main!.dataset.sort || "score",
        site: main!.dataset.site || "",
        ...overrides,
      };
      if (state.window && state.window !== "3h")
        params.set("window", state.window);
      if (state.sort && state.sort !== "score") params.set("sort", state.sort);
      if (state.site) params.set("site", state.site);
      // buildUrl(서버 쪽)과 동일하게, 전부 기본값으로 되돌아가는 링크에는 reset=1을
      // 남겨서 로그인 사용자의 저장된 필터 복원 로직이 가로채지 않게 한다.
      if (params.toString() === "") params.set("reset", "1");
      const qs = params.toString();
      return qs ? `/?${qs}` : "/";
    }

    function refreshFilterHrefs(): void {
      document
        .querySelectorAll<HTMLAnchorElement>("a[data-window-value]")
        .forEach(a => {
          a.href = buildClientUrl({ window: a.dataset.windowValue });
        });
      document
        .querySelectorAll<HTMLAnchorElement>("a[data-sort-value]")
        .forEach(a => {
          a.href = buildClientUrl({ sort: a.dataset.sortValue });
        });
      const currentSites = (main!.dataset.site || "").split(",").filter(Boolean);
      document
        .querySelectorAll<HTMLAnchorElement>("a[data-site-value]")
        .forEach(a => {
          const value = a.dataset.siteValue || "";
          // "전체" 핀(data-site-value="")을 다른 사이트처럼 토글 대상에 넣으면
          // currentSites에 빈 문자열이 그대로 얹혀서 "전체"를 눌러도 실제로는
          // 선택이 안 풀리는 버그가 있었다 — "전체"는 항상 선택 전체 해제로 고정.
          const toggled = !value
            ? []
            : currentSites.includes(value)
              ? currentSites.filter(s => s !== value)
              : [...currentSites, value];
          a.href = buildClientUrl({
            site: toggled.length ? toggled.join(",") : undefined,
          });
        });
    }

    // 검색 중에 기간/정렬/사이트 필터를 누르면, 원래는 그냥 일반 링크라 페이지가
    // 통째로 새로고침되면서 검색어가 날아간다. 검색 중일 때는 그 이동을 막고
    // 같은 검색어를 유지한 채 새 필터로 다시 검색한다(검색 중이 아니면 평소처럼
    // 그냥 링크 이동하게 둔다 — 기존에 검증된 동작을 안 건드리기 위해).
    function wireFilterNav(
      ariaLabel: string,
      datasetKey: "window" | "sort" | "site",
      defaultValue: string,
      activeClasses: string[],
      inactiveClasses: string[]
    ) {
      const nav = document.querySelector<HTMLElement>(
        `nav[aria-label="${ariaLabel}"]`
      );
      if (!nav) return;
      nav.addEventListener(
        "click",
        e => {
          const link = (e.target as HTMLElement).closest("a");
          if (!link || !nav.contains(link)) return;
          if (!searchModeActive) return; // 검색 중이 아니면 원래대로 페이지 이동

          e.preventDefault();
          const value = link.dataset[`${datasetKey}Value`] ?? defaultValue;
          main!.dataset[datasetKey] = value;
          refreshFilterHrefs();
          history.replaceState(history.state, "", buildClientUrl({}));

          nav.querySelectorAll("a").forEach(a => {
            const isTarget = a === link;
            a.classList.remove(...activeClasses, ...inactiveClasses);
            a.classList.add(...(isTarget ? activeClasses : inactiveClasses));
          });

          void runSearch(searchQuery);
        },
        { signal }
      );
    }

    wireFilterNav(
      "기간 필터",
      "window",
      "3h",
      ["bg-accent", "text-accent-foreground"],
      ["bg-muted", "hover:text-accent"]
    );
    wireFilterNav(
      "정렬 기준",
      "sort",
      "score",
      ["border-accent", "text-accent", "border"],
      ["border-border", "text-foreground/60", "hover:text-accent", "border"]
    );

    // 사이트 필터는 다중 선택이라(전체 -> 1개 -> 여러 개, 마지막 하나를 다시
    // 취소하면 전체로 복귀) window/sort처럼 "누른 값으로 그냥 교체"하는
    // wireFilterNav를 재사용할 수 없다 — 클릭된 site를 현재 선택 집합에
    // 토글해 넣는 별도 핸들러가 필요하다.
    function wireSiteFilterNav() {
      const activeClasses = ["border-accent", "text-accent", "border"];
      const inactiveClasses = [
        "border-border",
        "text-foreground/60",
        "hover:text-accent",
        "border",
      ];
      const nav = document.querySelector<HTMLElement>(
        'nav[aria-label="사이트 필터"]'
      );
      if (!nav) return;
      nav.addEventListener(
        "click",
        e => {
          const link = (e.target as HTMLElement).closest("a");
          if (!link || !nav.contains(link)) return;
          if (!searchModeActive) return; // 검색 중이 아니면 원래대로 페이지 이동

          e.preventDefault();
          const clicked = link.dataset.siteValue ?? "";
          const current = (main!.dataset.site || "").split(",").filter(Boolean);
          const next = !clicked
            ? [] // "전체"는 선택을 전부 비운다
            : current.includes(clicked)
              ? current.filter(s => s !== clicked)
              : [...current, clicked];
          main!.dataset.site = next.join(",");
          refreshFilterHrefs();
          history.replaceState(history.state, "", buildClientUrl({}));

          nav.querySelectorAll<HTMLAnchorElement>("a[data-site-value]").forEach(a => {
            const value = a.dataset.siteValue ?? "";
            const isActive = value === "" ? next.length === 0 : next.includes(value);
            a.classList.remove(...activeClasses, ...inactiveClasses);
            a.classList.add(...(isActive ? activeClasses : inactiveClasses));
          });

          void runSearch(searchQuery);
        },
        { signal }
      );
    }
    wireSiteFilterNav();
  }

  // astro:page-load는 최초 로드 시에도 발생한다(Astro 공식 동작). 아래처럼
  // setupInfiniteScroll()을 직접 한 번 더 부르면 같은 페이지에 옵저버/복원
  // 로직이 두 벌 생겨 서로 경합한다(실제 재현 후 확인 — 스크롤 복원이
  // 두 번 실행되며 아이템 개수가 목표치를 넘어서고 스크롤도 어긋났다).
  // 리스너 하나로만 등록한다.
  document.addEventListener("astro:page-load", setupInfiniteScroll);
</script>

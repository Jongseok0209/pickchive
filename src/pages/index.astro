---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PostRow from "@/components/PostRow.astro";
import {
  getRankedPosts,
  getSites,
  TIME_WINDOWS,
  DEFAULT_WINDOW,
  type SortKey,
} from "@/lib/posts";

export const prerender = false;

const PAGE_SIZE = 20;

const windowParam = Astro.url.searchParams.get("window") ?? DEFAULT_WINDOW;
const sortParam = (Astro.url.searchParams.get("sort") ?? "score") as SortKey;
const siteParam = Astro.url.searchParams.get("site") ?? "";

const [posts, sites] = await Promise.all([
  getRankedPosts({
    window: windowParam,
    sort: sortParam,
    site: siteParam || undefined,
    limit: PAGE_SIZE,
    offset: 0,
  }),
  getSites(),
]);

const nextOffset = posts.length === PAGE_SIZE ? PAGE_SIZE : null;

function buildUrl(overrides: Record<string, string | null>): string {
  const params = new URLSearchParams();
  const merged = {
    window: windowParam,
    sort: sortParam,
    site: siteParam,
    ...overrides,
  };
  if (merged.window && merged.window !== DEFAULT_WINDOW) params.set("window", merged.window);
  if (merged.sort && merged.sort !== "score") params.set("sort", merged.sort);
  if (merged.site) params.set("site", merged.site);
  const qs = params.toString();
  return qs ? `/?${qs}` : "/";
}

const SORT_OPTIONS: { key: SortKey; label: string }[] = [
  { key: "score", label: "종합" },
  { key: "views", label: "조회수" },
  { key: "recommend", label: "추천수" },
  { key: "comments", label: "댓글수" },
];
---

<Layout>
  <Header />
  <main
    id="main-content"
    class="app-layout my-1"
    data-window={windowParam}
    data-sort={sortParam}
    data-site={siteParam}
    data-next-offset={nextOffset ?? ""}
  >
    <section class="border-border border-b pt-6 pb-4">
      <nav class="mb-2 flex flex-wrap gap-1" aria-label="기간 필터">
        {
          TIME_WINDOWS.map(w => (
            <a
              href={buildUrl({ window: w.key })}
              class:list={[
                "rounded px-3 py-1.5 text-sm font-medium",
                w.key === windowParam
                  ? "bg-accent text-accent-foreground"
                  : "bg-muted hover:text-accent",
              ]}
            >
              {w.label}
            </a>
          ))
        }
      </nav>

      <nav class="mb-2 flex flex-wrap gap-1" aria-label="정렬 기준">
        {
          SORT_OPTIONS.map(s => (
            <a
              href={buildUrl({ sort: s.key })}
              class:list={[
                "rounded px-2.5 py-1 text-xs font-medium",
                s.key === sortParam
                  ? "border-accent text-accent border"
                  : "border-border text-foreground/60 hover:text-accent border",
              ]}
            >
              {s.label}
            </a>
          ))
        }
      </nav>

      <nav class="flex flex-wrap gap-1" aria-label="사이트 필터">
        <a
          href={buildUrl({ site: null })}
          class:list={[
            "rounded px-2.5 py-1 text-xs font-medium",
            !siteParam
              ? "border-accent text-accent border"
              : "border-border text-foreground/60 hover:text-accent border",
          ]}
        >
          전체
        </a>
        {
          sites.map(s => (
            <a
              href={buildUrl({ site: s.slug })}
              class:list={[
                "rounded px-2.5 py-1 text-xs font-medium",
                siteParam === s.slug
                  ? "border-accent text-accent border"
                  : "border-border text-foreground/60 hover:text-accent border",
              ]}
            >
              {s.name}
            </a>
          ))
        }
      </nav>
    </section>

    <ul id="post-list" class="pt-2">
      {posts.map(post => <PostRow post={post} />)}
      {
        posts.length === 0 && (
          <li class="text-foreground/60 py-12 text-center">
            아직 수집된 글이 없어요. 잠시 후 다시 확인해주세요.
          </li>
        )
      }
    </ul>

    <div id="infinite-sentinel" class="h-10"></div>
    <p id="loading-indicator" class="text-foreground/50 hidden py-4 text-center text-sm">
      불러오는 중...
    </p>
  </main>
  <Footer />
</Layout>

<script>
  function formatCount(n: number): string {
    if (n >= 10000) {
      const man = n / 10000;
      return `${man >= 100 ? Math.round(man) : man.toFixed(1).replace(/\.0$/, "")}만`;
    }
    if (n >= 1000) {
      const cheon = n / 1000;
      return `${cheon.toFixed(1).replace(/\.0$/, "")}천`;
    }
    return String(n);
  }

  function formatRelativeTime(dateStr: string | null): string {
    if (!dateStr) return "";
    const date = new Date(dateStr.endsWith("Z") ? dateStr : dateStr + "Z");
    const now = new Date();
    const diffSec = Math.floor((now.getTime() - date.getTime()) / 1000);

    if (diffSec < 60) return "방금 수집";
    const diffMin = Math.floor(diffSec / 60);
    if (diffMin < 60) return `${diffMin}분 전 수집`;
    const diffHour = Math.floor(diffMin / 60);
    if (diffHour < 24) return `${diffHour}시간 전 수집`;
    const diffDay = Math.floor(diffHour / 24);
    return `${diffDay}일 전 수집`;
  }

  function decodeEntities(s: string): string {
    let decoded = s;
    let prev = "";
    while (decoded !== prev) {
      prev = decoded;
      decoded = decoded
        .replace(/&quot;/gi, '"')
        .replace(/&apos;/gi, "'")
        .replace(/&amp;/gi, "&")
        .replace(/&lt;/gi, "<")
        .replace(/&gt;/gi, ">")
        .replace(/&#039;/g, "'")
        .replace(/&#39;/g, "'")
        .replace(/&#(\d+);/g, (_, code) => String.fromCharCode(Number(code)))
        .replace(/&#x([0-9a-f]+);/gi, (_, code) => String.fromCharCode(parseInt(code, 16)));
    }
    return decoded;
  }

  function escapeHtml(s: string): string {
    return decodeEntities(s)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  interface Post {
    id: number;
    title: string;
    url: string;
    author: string | null;
    viewCount: number;
    recommendCount: number;
    commentCount: number | null;
    category: string | null;
    postedAtRaw: string | null;
    crawledAt: string;
    siteSlug: string;
    siteName: string;
  }

  function renderRow(post: Post): string {
    const metaParts: string[] = [];
    if (post.author) metaParts.push(`<span>${escapeHtml(post.author)}</span>`);
    if (post.postedAtRaw) metaParts.push(`<span>${escapeHtml(post.postedAtRaw)}</span>`);
    metaParts.push(`<span>조회 ${formatCount(post.viewCount)}</span>`);
    metaParts.push(`<span>추천 ${formatCount(post.recommendCount)}</span>`);
    const relTime = formatRelativeTime(post.crawledAt);
    if (relTime) metaParts.push(`<span class="text-accent/80 font-medium">${relTime}</span>`);
    if (post.category) metaParts.push(`<span>${escapeHtml(post.category)}</span>`);
    metaParts.push(
      `<a href="/p/${post.id}#comments" data-astro-reload class="text-accent hover:underline">댓글 보기</a>`
    );

    const commentBadge = post.commentCount
      ? `<span class="text-foreground/50 ms-1 text-sm" title="크롤링 시점 기준 원본 댓글 수 (실시간 아님)">[원본 댓글 ${post.commentCount}]</span>`
      : "";

    return `<li class="border-border border-b py-3" data-post-id="${post.id}">
      <div class="flex items-start gap-2">
        <span class="bg-muted text-foreground/70 shrink-0 rounded px-1.5 py-0.5 text-xs font-medium" data-site="${post.siteSlug}">${escapeHtml(post.siteName)}</span>
        <div class="min-w-0 flex-1">
          <a href="${escapeHtml(post.url)}" rel="noopener noreferrer nofollow" class="hover:text-accent font-medium break-words">${escapeHtml(post.title)}</a>
          ${commentBadge}
          <div class="text-foreground/60 mt-1 flex flex-wrap gap-x-2 text-xs">${metaParts.join("")}</div>
        </div>
      </div>
    </li>`;
  }

  // 홈 피드는 무한스크롤이라, 처음 20개 이후로 스크롤해서 불러온 글들은
  // 서버가 렌더링한 HTML에는 없고 이 탭의 메모리(DOM)에만 존재한다.
  // 글 제목을 눌러 다른 사이트로 이동했다가 브라우저가 이 탭을
  // 메모리 부족 등으로 새로고침(tab discard)해버리면, 스크롤 위치를
  // 완벽히 복원해도 페이지 자체가 처음 20개짜리로 훨씬 짧아져 있어서
  // 사실상 맨 위로 돌아간 것처럼 느껴진다. 그래서 스크롤 위치뿐 아니라
  // "몇 개나 불러왔었는지"도 같이 저장해뒀다가, 새로고침되면 그만큼
  // 먼저 다시 불러온 다음에 스크롤을 복원한다.
  const FEED_STATE_KEY = "pc-feed-state";

  // 브라우저 자체 스크롤 복원은 우리가 글을 다시 불러오기 "전"(=페이지가 20개짜리로
  // 짧을 때) 실행돼서 엉뚱한 위치로 튄 뒤, 그 스크롤 이벤트가 저장 로직을 건드려
  // 원래 위치를 덮어써버린다. 복원은 우리가 직접 하므로 브라우저 것은 끈다.
  if ("scrollRestoration" in history) history.scrollRestoration = "manual";

  // 복원이 진행되는 동안에는 저장하지 않는다. 복원 중 발생하는 스크롤/로드가
  // 저장된 목표값(원래 보던 위치)을 덮어쓰면 복원 자체가 무의미해진다.
  let restoringFeed = false;
  let feedListeners: AbortController | undefined;

  function saveFeedState(list: HTMLUListElement) {
    if (restoringFeed) return;
    try {
      sessionStorage.setItem(
        FEED_STATE_KEY,
        JSON.stringify({
          path: location.pathname + location.search,
          itemCount: list.children.length,
          scrollY: window.scrollY,
        })
      );
    } catch {
      // sessionStorage 접근 불가(프라이빗 모드 등)해도 기능 자체는 계속 동작
    }
  }

  function setupInfiniteScroll() {
    const main = document.querySelector<HTMLElement>("#main-content");
    const list = document.querySelector<HTMLUListElement>("#post-list");
    const sentinel = document.querySelector<HTMLElement>("#infinite-sentinel");
    const loadingEl = document.querySelector<HTMLElement>("#loading-indicator");
    if (!main || !list || !sentinel || !loadingEl) return;

    let nextOffset: number | null = main.dataset.nextOffset
      ? Number(main.dataset.nextOffset)
      : null;
    let loading = false;

    async function loadMore(): Promise<boolean> {
      if (loading || nextOffset === null) return false;
      loading = true;
      loadingEl!.classList.remove("hidden");

      const params = new URLSearchParams({
        window: main!.dataset.window ?? "24h",
        sort: main!.dataset.sort ?? "score",
        offset: String(nextOffset),
      });
      if (main!.dataset.site) params.set("site", main!.dataset.site);

      try {
        const res = await fetch(`/api/posts?${params.toString()}`);
        const data = (await res.json()) as { posts: Post[]; nextOffset: number | null };
        list!.insertAdjacentHTML(
          "beforeend",
          data.posts.map(p => renderRow(p)).join("")
        );
        nextOffset = data.nextOffset;
        if (nextOffset === null) observer.disconnect();
        return data.posts.length > 0;
      } catch {
        // 네트워크 오류 시 다음 스크롤에서 재시도
        return false;
      } finally {
        loading = false;
        loadingEl!.classList.add("hidden");
      }
    }

    const observer = new IntersectionObserver(entries => {
      if (!entries[0].isIntersecting) return;
      void loadMore();
    });

    // 새로 로드된 페이지는 아이템이 20개뿐이라 sentinel이 화면 안에 바로 들어와
    // observer가 즉시 발동한다. 복원 로직(아래)이 목표 개수만큼 순차적으로
    // 불러오는 도중에 observer가 동시에 추가로 더 불러와버리면 개수가 목표를
    // 넘어서고(예: 140개 복원 중인데 160개가 됨), scrollTo도 그 사이에 씹혀서
    // 0으로 되돌아가는 문제가 있었다(실제 재현 후 확인). 그래서 복원이 끝날
    // 때까지 observer를 붙이지 않는다.
    async function restoreFeedState(): Promise<void> {
      let saved: { path: string; itemCount: number; scrollY: number } | null = null;
      try {
        const raw = sessionStorage.getItem(FEED_STATE_KEY);
        saved = raw ? JSON.parse(raw) : null;
      } catch {
        saved = null;
      }
      if (!saved || saved.path !== location.pathname + location.search) return;

      restoringFeed = true;
      while (list!.children.length < saved.itemCount) {
        const gotMore = await loadMore();
        if (!gotMore) break;
      }
      // 마지막에 붙은 항목들의 이미지/레이아웃이 자리를 잡은 뒤에 스크롤해야
      // 목표 위치에 정확히 안착한다.
      await new Promise(resolve => requestAnimationFrame(() => resolve(null)));
      window.scrollTo(0, saved.scrollY);
    }

    restoreFeedState().finally(() => {
      restoringFeed = false;
      observer.observe(sentinel);
    });

    // window/document 리스너는 DOM 교체(Astro 뷰 트랜지션)로 사라지지 않는다.
    // 페이지를 오갈 때마다 setup이 다시 불리므로 정리하지 않으면 리스너가
    // 겹겹이 쌓이고, 오래된 리스너가 이미 화면에서 떨어져 나간 옛 목록을
    // 참조한 채 엉뚱한 값을 저장해 복원을 망가뜨린다.
    feedListeners?.abort();
    feedListeners = new AbortController();
    const { signal } = feedListeners;

    let scrollSaveTimer: number | undefined;
    window.addEventListener(
      "scroll",
      () => {
        window.clearTimeout(scrollSaveTimer);
        scrollSaveTimer = window.setTimeout(() => saveFeedState(list!), 200);
      },
      { passive: true, signal }
    );
    document.addEventListener(
      "visibilitychange",
      () => {
        if (document.visibilityState === "hidden") saveFeedState(list!);
      },
      { signal }
    );
    window.addEventListener("pagehide", () => saveFeedState(list!), { signal });

    // pagehide/visibilitychange 시점엔 브라우저가 이미 스크롤 위치를 0으로
    // 되돌려놓은 뒤라(실제 확인함 — 저장된 scrollY가 항상 0으로 찍힘) 너무 늦다.
    // 글 링크를 실제로 누르는 그 순간(클릭 캡처 단계, 아직 페이지 이동 전)에
    // 곧바로 저장해야 정확한 스크롤 위치가 남는다.
    list!.addEventListener(
      "click",
      e => {
        if ((e.target as HTMLElement).closest("a")) saveFeedState(list!);
      },
      { capture: true, signal }
    );
  }

  // astro:page-load는 최초 로드 시에도 발생한다(Astro 공식 동작). 아래처럼
  // setupInfiniteScroll()을 직접 한 번 더 부르면 같은 페이지에 옵저버/복원
  // 로직이 두 벌 생겨 서로 경합한다(실제 재현 후 확인 — 스크롤 복원이
  // 두 번 실행되며 아이템 개수가 목표치를 넘어서고 스크롤도 어긋났다).
  // 리스너 하나로만 등록한다.
  document.addEventListener("astro:page-load", setupInfiniteScroll);
</script>

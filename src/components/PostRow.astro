---
import { formatCount, formatRelativeTime, decodeEntities } from "@/lib/format";
import { TRENDING_THRESHOLD, type PostWithSite } from "@/lib/posts";

interface Props {
  post: PostWithSite;
}

const { post } = Astro.props;
const isTrending = post.viewGrowth >= TRENDING_THRESHOLD;
const relativeCrawledTime = formatRelativeTime(post.crawledAt);
---

<li class="border-border border-b py-3" data-post-id={post.id}>
  <div class="flex items-start gap-2">
    <span
      class="bg-muted text-foreground/70 shrink-0 rounded px-1.5 py-0.5 text-xs font-medium"
      data-site={post.siteSlug}
    >
      {post.siteName}
    </span>
    <div class="min-w-0 flex-1">
      {
        isTrending && (
          <span class="mr-1 text-sm" title={`최근 2시간 조회수 +${post.viewGrowth}`}>
            🔥
          </span>
        )
      }
      <a
        href={post.url}
        rel="noopener noreferrer nofollow"
        class="hover:text-accent font-medium break-words"
      >
        {decodeEntities(post.title)}
      </a>
      {
        !!post.commentCount && (
          <span
            class="text-foreground/50 ms-1 text-sm"
            title="크롤링 시점 기준 원본 댓글 수 (실시간 아님)"
          >
            [원본 댓글 {post.commentCount}]
          </span>
        )
      }
      <div class="text-foreground/60 mt-1 flex flex-wrap gap-x-2 text-xs">
        {post.author && <span>{post.author}</span>}
        {post.postedAtRaw && <span>{post.postedAtRaw}</span>}
        <span>조회 {formatCount(post.viewCount)}</span>
        <span>추천 {formatCount(post.recommendCount)}</span>
        {relativeCrawledTime && <span class="text-accent/80 font-medium">{relativeCrawledTime}</span>}
        {post.category && <span>{post.category}</span>}
        <a href={`/p/${post.id}#comments`} class="text-accent hover:underline">
          댓글 보기
        </a>
      </div>
    </div>
  </div>
</li>


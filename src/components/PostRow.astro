---
import {
  formatCount,
  formatElapsedLabel,
  decodeEntities,
  titleHasCommentCountSuffix,
} from "@/lib/format";
import { type PostWithSite } from "@/lib/posts";

interface Props {
  post: PostWithSite;
}

const { post } = Astro.props;
// "게시"는 기간 필터가 실제로 쓰는 first_seen_at 기준, "업데이트"는 조회수/추천수를
// 마지막으로 갱신한 crawled_at 기준 — 둘을 같이 보여줘야 필터 결과랑 화면이 안 헷갈린다.
const postedAgeLabel = formatElapsedLabel(post.firstSeenAt, "게시");
const updatedAgeLabel = formatElapsedLabel(post.crawledAt, "업데이트");
const decodedTitle = decodeEntities(post.title);
const showCommentBadge =
  !!post.commentCount &&
  !titleHasCommentCountSuffix(decodedTitle, post.commentCount);
---

<li class="border-border border-b py-3" data-post-id={post.id}>
  <div class="flex items-start gap-2">
    <span
      class="bg-muted text-foreground/70 shrink-0 rounded px-1.5 py-0.5 text-xs font-medium"
      data-site={post.siteSlug}
    >
      {post.siteName}
    </span>
    <div class="min-w-0 flex-1">
      <a
        href={post.url}
        rel="noopener noreferrer nofollow"
        data-post-title-link
        class="hover:text-accent font-medium break-words"
      >
        {decodedTitle}
      </a>
      {
        showCommentBadge && (
          <span
            class="text-foreground/50 ms-1 text-sm"
            title="크롤링 시점 기준 원본 댓글 수 (실시간 아님)"
          >
            ({post.commentCount})
          </span>
        )
      }
      <div class="text-foreground/60 mt-1 flex flex-wrap gap-x-2 text-xs">
        {post.author && <span>{post.author}</span>}
        {post.postedAtRaw && <span>{post.postedAtRaw}</span>}
        <span>조회 {formatCount(post.viewCount)}</span>
        <span>추천 {formatCount(post.recommendCount)}</span>
        {postedAgeLabel && <span>{postedAgeLabel}</span>}
        {
          updatedAgeLabel && (
            <span class="text-accent/80 font-medium">{updatedAgeLabel}</span>
          )
        }
        {post.category && <span>{post.category}</span>}
        <!--
          data-astro-reload: 뷰 트랜지션(클라이언트 라우팅)으로 이동하면 Astro의
          자체 스크롤 복원이 우리 피드 복원 로직과 충돌해 뒤로가기 시 목록/스크롤이
          날아간다(실제 재현 확인). 전체 페이지 로드 경로는 정상 동작하므로 그쪽으로 보낸다.
        -->
        <a
          href={`/p/${post.id}#comments`}
          data-astro-reload
          class="text-accent hover:underline"
        >
          댓글 보기
        </a>
      </div>
    </div>
  </div>
</li>
